# 复制为 .env 后按需修改（docker compose 会自动读取同目录 .env）
# 仅列出部署常用项；完整环境变量见 docs/api-contract.md。

# ---- 基础 ----
TZ=Asia/Shanghai
HTTP_PORT=8080
# 容器内进程用户；建议与你媒体目录属主一致（NAS 上常见 1000 或 1026）
PUID=1000
PGID=1000

# ---- 媒体与数据卷 ----
# 媒体根目录（宿主机路径）。默认只读挂载。
MEDIA_DIR=/volume1/comics
CONFIG_DIR=./config
CACHE_DIR=./cache

# ---- 安全开关（默认最保守，按需再开）----
# readonly | writeback（writeback 才允许「整理」重命名/移动与 NFO 写回，且还要在设置页开开关 + 二次确认）
DATA_MODE=readonly
# E-H 刮削总开关（false 时任何页面都不会发外网请求；开启后仍需在设置页填 Cookie 并手动触发）
ENABLE_SCRAPER=false
# AI 自然语言搜索总开关（false 时 /api/ai/* 一律 409；开启后仍需在设置页填 API Key）
# AI 自然语言搜索/翻译/分类的硬开关；改 true 后重启容器，再到设置页打开 AI 开关
ENABLE_LLM_SEARCH=false   # 兼容保留：已不再是硬门禁，AI 在设置页填 Key 后打开开关即可
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- 资源 ----
CACHE_LIMIT_GB=20
MAX_TRANSCODE=1
# auto | qsv | vaapi | none（群晖 ARM 用 none；飞牛 N100 建议 qsv）
HWACCEL=auto
LOG_LEVEL=info

# ---- 反向代理/CORS（浏览器同源访问不需要；跨域 WebView 客户端才需要）----
# CORS_ORIGINS=https://nekoshelf.example.com

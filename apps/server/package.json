{
  "name": "@nekoshelf/server",
  "version": "0.6.4",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "nekoshelf": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts src/cli.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist --packages=external --log-level=warning",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "cli": "tsx src/cli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.4.3",
    "@fastify/static": "^8.2.0",
    "@nekoshelf/adapters": "workspace:*",
    "@nekoshelf/core": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5.4.0",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
